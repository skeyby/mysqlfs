#!/bin/sh

set -e

case "$1" in
    configure)
        cat <<'EOF'
mysqlfs has been installed.

To start using it:

  1. Create a MySQL or MariaDB database and account for mysqlfs.
  2. Run:
       mysqlfs_setup
  3. Mount the filesystem, for example:
       mkdir -p /mnt/mysqlfs
       mysqlfs -ohost=localhost -ouser=mysqlfs -opassword=secret -odatabase=mysqlfs -odefault_permissions /mnt/mysqlfs

Full setup and usage notes:
  zless /usr/share/doc/mysqlfs/README.md.gz
EOF
        ;;
esac

exit 0
